  "components": {
    "schemas": {
      "AttributeUpserted": {
        "type": "object",
        "description": "An attribute upsert result.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `upserted`."
          }
        }
      },
      "CreatePolicySetBody": {
        "type": "object",
        "description": "`POST /v1/admin/policy-sets` - create a tenant policy set (name in body).\nThe RFW create form is POST-only and cannot PUT to a path with\nthe name; the shared `put_policy_set` core runs with `origin='tenant'`\nvalidation, then the renderer is redirected to the editor page.",
        "required": [
          "policy_set_name",
          "policies"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "policies": {
            "type": "string"
          },
          "policy_set_name": {
            "type": "string"
          },
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Decision": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "decision"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "allow"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason",
              "decision"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "deny"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "LiquidationResponse": {
        "type": "object",
        "required": [
          "id",
          "env_id",
          "account_id",
          "close_qty",
          "close_is_buy",
          "shortfall",
          "state",
          "ts"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "close_is_buy": {
            "type": "boolean"
          },
          "close_qty": {
            "type": "string"
          },
          "contract_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "env_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "shortfall": {
